{
    "services": {
          "frontend": {
                  "root": "frontend",
                  "framework": "vite"
          },
          "backend": {
                  "root": "backend",
                  "framework": "express",
                  "entrypoint": "src/server.ts"
          }
    },
    "rewrites": [
          {
                  "source": "/api/(.*)",
                  "destination": {
                            "service": "backend"
                  }
          },
          {
                  "source": "/socket.io/(.*)",
                  "destination": {
                            "service": "backend"
                  }
          },
          {
                  "source": "/(.*)",
                  "destination": {
                            "service": "frontend"
                  }
          }
    ]
}
